# Steam Wishlist App - Production Environment
# Copy this file to .env and fill in your values

# JWT secret for signing authentication tokens (use a strong random value)
JWT_SECRET=change-me-to-a-strong-random-secret

# Currency code for Steam Store API prices (e.g., USD, CAD, EUR)
STEAM_API_CC=USD

# Scheduled price refresh settings (daily)
# Time is interpreted in the specified timezone
PRICE_REFRESH_HOUR=13
PRICE_REFRESH_MINUTE=0
PRICE_REFRESH_TIMEZONE=America/New_York
